+    pub fn updateFontSizeAndSize(self: *Surface, points: f32, width: u32, height: u32) void {
+        if (std.math.isNan(points)) return;
+        var font_size = self.core_surface.font_size;
+        font_size.points = std.math.clamp(points, 1.0, 255.0);
+        self.core_surface.setFontSizeAndScreen(font_size, .{
+            .width = width,
+            .height = height,
+        }) catch |err| {
+            log.err("error in font size and size callback err={}", .{err});
+            return;
+        };
+        self.core_surface.font_size_adjusted = true;
+        self.size = .{ .width = width, .height = height };
+    }
