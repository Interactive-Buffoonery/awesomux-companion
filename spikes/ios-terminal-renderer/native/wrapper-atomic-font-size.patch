+        /// Sets ``fontSize`` and resizes the view to `size` as one change, so
+        /// the terminal grid is resized once, at the new font and size.
+        /// Setting the font and then the frame would resize the grid at the
+        /// new font and the old size in between, which can drop rows the
+        /// final size keeps. False on native rejection, with no surface yet,
+        /// or an empty size. Rejection preserves the frame and font tracker.
+        @discardableResult
+        func setFontSize(_ points: Float, size: CGSize) -> Bool {
+            let previousSize = frame.size
+            frame.size = size
+            guard core.setFontSizeAtViewSize(points) else {
+                frame.size = previousSize
+                return false
+            }
+            return true
+        }
+
