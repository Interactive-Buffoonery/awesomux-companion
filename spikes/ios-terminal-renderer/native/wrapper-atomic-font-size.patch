+    /// Moves the font and the pixel size in one native step, so the grid is
+    /// only ever resized at its final size. A font change on its own resizes
+    /// the grid at the old pixel size first, which can drop rows the final
+    /// size keeps. The view must already have its new size.
+    @discardableResult
+    func setFontSizeAtViewSize(_ points: Float) -> Bool {
+        guard let surface, fontSize != nil, !points.isNaN else { return false }
+        let scale = scaleFactor()
+        let size = viewSize()
+        let pixelWidth = (size.width * scale).rounded(.down)
+        let pixelHeight = (size.height * scale).rounded(.down)
+        guard pixelWidth >= 1, pixelHeight >= 1,
+              pixelWidth <= Double(UInt32.max), pixelHeight <= Double(UInt32.max)
+        else { return false }
+        guard surface.setFontSizeAndSize(points: points, width: UInt32(pixelWidth), height: UInt32(pixelHeight))
+        else { return false }
+        applyFontSizeAction(.set(points))
+        performMetricsSync()
         return true
     }
 
